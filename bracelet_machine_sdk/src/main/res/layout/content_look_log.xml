<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LookLogActivity">
    <RelativeLayout
        android:layout_centerInParent="true"
        android:background="@drawable/tranbg"
        android:padding="30dp"
        android:layout_width="900dp"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="#fff"
            android:textSize="24sp"
            android:text="日志"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

            <RelativeLayout
                android:layout_centerHorizontal="true"
                android:layout_marginTop="70dp"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ScrollView
                    android:id="@+id/scroll_view"
                    android:background="#fff"
                    android:padding="10dp"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="500dp">
                    <TextView
                        android:id="@+id/log_content"
                        android:textColor="#333"
                        android:textSize="22sp"
                        android:text=""
                        android:background="#fff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </ScrollView>
                <LinearLayout
                    android:layout_below="@+id/scroll_view"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal"
                    android:layout_marginLeft="100dp"
                    android:layout_marginRight="100dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Button
                            android:id="@+id/upload"
                            android:text="上 传"
                            android:layout_gravity="center"
                            android:textSize="24sp"
                            android:textColor="#4FDFBA"
                            android:background="@drawable/shape_start"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" /></LinearLayout>
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Button
                            android:id="@+id/refresh"
                            android:text="刷 新"
                            android:textSize="24sp"
                            android:textColor="#de4746"
                            android:background="@drawable/shape_end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>
            </RelativeLayout>
        <Spinner
            android:layout_toLeftOf="@+id/close"
            android:layout_marginRight="10dp"
            android:id="@+id/date_list"
            android:layout_width="240dp"
            android:layout_height="60dp"></Spinner>
            <RelativeLayout
                android:id="@+id/close"
                android:layout_marginLeft="10dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:layout_width="80dp"
                android:layout_height="80dp">
                <ImageView
                    android:layout_alignParentTop="true"
                    android:layout_alignParentRight="true"
                    android:src="@drawable/close"
                    android:layout_width="40dp"
                    android:layout_height="40dp" />
            </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>